        },
        {
          "type": "exercise",
          "number": 2,
          "text": "他递A一块毛巾B给C我擦D 汗。"
        },
        {
          "type": "exercise",
          "number": 3,
          "text": "青年走A到B 门口,转C 身D说:“我们会再见的。”"
        }
      ],
