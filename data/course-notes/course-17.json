      "blocks": [
        {
          "type": "explanation",
          "text": "“宁可”，副词，表示经过比较以后，选择相对有利的一方。例如："
        },
        {
          "type": "example",
          "number": 1,
          "text": "作为母亲，她宁可自己累一点儿，也不想委屈了孩子。"
        },
        {
          "type": "example",
          "number": 2,
          "text": "为什么大家宁可挤成一团，也不去没人的那边？"
        },
        {
          "type": "example",
          "number": 3,
          "text": "……做节目时，与开幕式相比，我们宁可把更多的精力集中在闭幕式上，……"
        }
      ],
      "practice": [
        {
          "type": "exercise",
          "number": 1,
          "text": "我宁可花钱去餐厅吃,"
        },
        {
          "type": "exercise",
          "number": 2,
          "text": "为了把这篇文章写好, _____。 (宁可)"
